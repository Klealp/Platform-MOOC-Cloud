# Videos y audios generados por generar_perfiles.sh (pesan decenas de MB).
# Se reconstruyen con el script; perfiles.json SI se versiona como evidencia.
media/*
!media/perfiles.json

# seed.json contiene tokens de sesion: es un secreto, nunca se sube.
datos/

# Binarios compilados por construir_herramientas.sh
bin/

# Registros de los monitores (el contenido util ya queda en los CSV)
resultados/**/monitor_*.log
