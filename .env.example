# =====================================================================
# Configuracion de la plataforma MOOC
# Copia este archivo como .env:   cp .env.example .env
# El archivo .env NO se versiona (esta en .gitignore).
# =====================================================================

APP_ENV=dev
HTTP_ADDR=:8080
# URL con la que el mundo exterior alcanza la API. Se usa para construir
# enlaces de correo, URLs de verificacion de insignias y listas HLS.
PUBLIC_BASE_URL=http://localhost:8080

# --- PostgreSQL ---
DATABASE_URL=postgres://mooc:mooc@postgres:5432/mooc?sslmode=disable

# --- Redis ---
REDIS_ADDR=redis:6379
REDIS_PASSWORD=

# --- Almacenamiento de objetos ---
# S3_ENDPOINT es el nombre INTERNO de Docker (contenedor a contenedor).
# S3_PUBLIC_ENDPOINT es el que ve tu navegador: las URLs prefirmadas se
# reescriben con este host para que funcionen desde Windows.
S3_ENDPOINT=minio:9000
S3_PUBLIC_ENDPOINT=localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=mooc
S3_REGION=us-east-1
S3_USE_SSL=false

# Vacio en local: los archivos se entregan con URL prefirmada de MinIO.
# En la Entrega 2 apuntara a Cloud CDN / CloudFront.
CDN_BASE_URL=

# --- Correo (Mailpit) ---
SMTP_ADDR=mailpit:1025
SMTP_FROM=no-reply@mooc.local

# --- Politicas ---
SESSION_TTL_HOURS=24
AUTH_TOKEN_TTL_HOURS=24
UPLOAD_TTL_HOURS=24
SIGNED_URL_TTL_MINUTES=15
RATE_LIMIT_PER_MIN=120
MAX_UPLOAD_MB=2048

# --- Workers ---
WORKER_CONCURRENCY=4
MAX_RETRIES=3

# --- Antimalware ---
# stub  = detecta la firma de prueba EICAR (suficiente para demostrar)
# off   = desactivado
ANTIMALWARE_MODE=stub
CLAMAV_ADDR=

# --- Administrador inicial ---
# La API lo crea al arrancar si no existe. Cambia la contrasena despues.
ADMIN_EMAIL=admin@mooc.local
ADMIN_PASSWORD=Admin123!

# --- Observabilidad (OpenTelemetry) ---
# Colector OTLP/HTTP al que la API y el worker envian sus trazas.
# En el stack local es el contenedor Jaeger. Dejalo VACIO para apagar las
# trazas sin tocar el codigo.
OTEL_EXPORTER_OTLP_ENDPOINT=jaeger:4318
# Fraccion de trazas muestreadas (1.0 = todas; baja este valor con mucho trafico).
OTEL_SAMPLE_RATIO=1.0
