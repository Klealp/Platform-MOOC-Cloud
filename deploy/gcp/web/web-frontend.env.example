# =====================================================================
# Frontend (BFF Next.js) en el Web Server - plantilla SIN secretos.
# provision.sh (paso "config") deja el resultado en /etc/mooc/web-frontend.env.
# =====================================================================

NODE_ENV=production

# URL del backend Go vista DESDE EL CONTENEDOR del frontend. Es el nombre del
# servicio en la red interna de Docker Compose (ver docker-compose.yml), NO
# localhost ni el dominio publico: el BFF habla con la API por la red privada
# del host, sin pasar por Caddy ni salir a Internet.
API_BASE_URL=http://api:8080/api/v1

# Nombre de la cookie HttpOnly de sesion. Como el sitio se sirve por HTTPS
# (Caddy termina TLS), con NODE_ENV=production la cookie se marca Secure.
SESSION_COOKIE_NAME=mooc_session
