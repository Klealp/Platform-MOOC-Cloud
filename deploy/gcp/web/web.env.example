# =====================================================================
# Web Server - plantilla SIN secretos. provision.sh (paso "config")
# reemplaza los <MARCADORES> y deja el resultado en /etc/mooc/web.env.
# =====================================================================

APP_ENV=prod
HTTP_ADDR=:8080
DOMAIN=<DOMINIO>
PUBLIC_BASE_URL=https://<DOMINIO>

# --- Cloud SQL: IP privada (Private Service Access) y TLS obligatorio ---
DATABASE_URL=postgres://mooc:<DB_PASSWORD>@<IP_CLOUDSQL>:5432/mooc?sslmode=require

# --- Redis/asynq en el Worker Server, por la red privada ---
REDIS_ADDR=<IP_WORKER>:6379
REDIS_PASSWORD=<REDIS_PASSWORD>

# --- Cloud Storage via API XML compatible con S3 (llave HMAC de mooc-api) ---
# El endpoint interno y el publico son el mismo: el cliente sube y descarga
# directamente contra storage.googleapis.com por HTTPS.
S3_ENDPOINT=storage.googleapis.com
S3_PUBLIC_ENDPOINT=storage.googleapis.com
S3_ACCESS_KEY=<HMAC_ACCESS_ID>
S3_SECRET_KEY=<HMAC_SECRET>
S3_BUCKET=<BUCKET>
S3_REGION=auto
S3_USE_SSL=true
# Sin CDN en esta entrega: el contenido se sirve desde el bucket.
CDN_BASE_URL=

# --- Correo: Mailpit en el Worker Server ---
SMTP_ADDR=<IP_WORKER>:1025
SMTP_FROM=no-reply@mooc.local

# --- Politicas ---
SESSION_TTL_HOURS=24
AUTH_TOKEN_TTL_HOURS=24
UPLOAD_TTL_HOURS=24
SIGNED_URL_TTL_MINUTES=15
# 120 en operacion normal. Para las pruebas de carga se sube (p. ej.
# RATE_LIMIT_PER_MIN=10000000000 ./deploy/gcp/provision.sh config) para
# medir la plataforma y no el limitador; el valor se registra en el informe.
RATE_LIMIT_PER_MIN=<RATE_LIMIT_PER_MIN>
MAX_UPLOAD_MB=2048

ANTIMALWARE_MODE=stub
CLAMAV_ADDR=

# --- Administrador inicial (se crea al arrancar si no existe) ---
ADMIN_EMAIL=admin@mooc.local
ADMIN_PASSWORD=<ADMIN_PASSWORD>

# Trazas apagadas: Jaeger no cabe en 2 GiB junto a la API.
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_SAMPLE_RATIO=1.0
