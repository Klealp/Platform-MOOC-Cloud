# =====================================================================
# Worker Server - plantilla SIN secretos. provision.sh (paso "config")
# reemplaza los <MARCADORES> y deja el resultado en /etc/mooc/worker.env.
# =====================================================================

APP_ENV=prod
PUBLIC_BASE_URL=https://<DOMINIO>

DATABASE_URL=postgres://mooc:<DB_PASSWORD>@<IP_CLOUDSQL>:5432/mooc?sslmode=require

# Redis corre en esta misma maquina; el worker lo alcanza por la red de
# Docker. La contrasena tambien la usa el propio contenedor de Redis.
REDIS_ADDR=redis:6379
REDIS_PASSWORD=<REDIS_PASSWORD>

# --- Cloud Storage (llave HMAC de mooc-worker, distinta a la de la API) ---
S3_ENDPOINT=storage.googleapis.com
S3_PUBLIC_ENDPOINT=storage.googleapis.com
S3_ACCESS_KEY=<HMAC_ACCESS_ID>
S3_SECRET_KEY=<HMAC_SECRET>
S3_BUCKET=<BUCKET>
S3_REGION=auto
S3_USE_SSL=true
CDN_BASE_URL=

SMTP_ADDR=mailpit:1025
SMTP_FROM=no-reply@mooc.local

SIGNED_URL_TTL_MINUTES=15

# --- Workers ---
# Fija durante todas las corridas de carga (el enunciado lo exige). Con 2
# vCPU, dos transcodificaciones simultaneas ya saturan la maquina.
WORKER_CONCURRENCY=2
MAX_RETRIES=3

ANTIMALWARE_MODE=stub
CLAMAV_ADDR=

OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_SAMPLE_RATIO=1.0
