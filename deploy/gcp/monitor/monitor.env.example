# =====================================================================
# Monitoreo en el Web Server - plantilla SIN secretos. provision.sh (paso
# "config") reemplaza los <MARCADORES> y deja el resultado en
# /etc/mooc/monitor.env.
# =====================================================================

# --- redis-exporter: Redis del Worker Server por la red privada ---
REDIS_ADDR=redis://<IP_WORKER>:6379
REDIS_PASSWORD=<REDIS_PASSWORD>

# --- postgres-exporter: Cloud SQL por IP privada, TLS obligatorio ---
DATA_SOURCE_NAME=postgresql://mooc:<DB_PASSWORD>@<IP_CLOUDSQL>:5432/mooc?sslmode=require
