# =====================================================================
# infra-server (Entrega 3) - plantilla SIN secretos. provision.sh la
# completa y la guarda en Secret Manager (mooc-infra-env); startup.sh la
# escribe en /etc/mooc/infra.env al arrancar.
# =====================================================================

# La misma contrasena va en api.env y worker.env (REDIS_PASSWORD).
REDIS_PASSWORD=<REDIS_PASSWORD>

# --- queue-metrics: lee Redis por la red de Docker de esta misma VM ---
REDIS_ADDR=redis:6379
# Proyecto vacio = el del servidor de metadatos. Publica cada 30 s.
QUEUE_METRICS_PROJECT=
QUEUE_METRICS_INTERVAL_SECONDS=30
