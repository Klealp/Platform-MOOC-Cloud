# =====================================================================
# Grupo mooc-web (Entrega 3) - plantilla SIN secretos. provision.sh la
# completa y la guarda en Secret Manager (mooc-web-env); startup.sh la
# escribe en /etc/mooc/web.env de la VM al arrancar.
# =====================================================================

NODE_ENV=production

# El frontend ya no comparte maquina con la API: el BFF la llama por el
# balanceador, con el mismo dominio publico que usa el navegador. Desde el
# servidor de Next.js es una llamada HTTPS saliente (por Cloud NAT).
API_BASE_URL=https://<DOMINIO>/api/v1

# Nombre de la cookie HttpOnly de sesion. Con NODE_ENV=production y HTTPS en
# el balanceador, la cookie se marca Secure.
SESSION_COOKIE_NAME=mooc_session
