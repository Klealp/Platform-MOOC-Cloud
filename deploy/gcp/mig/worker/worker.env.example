# =====================================================================
# Grupo mooc-worker (Entrega 3) - plantilla SIN secretos. provision.sh la
# completa y la guarda en Secret Manager (mooc-worker-env); startup.sh la
# escribe en /etc/mooc/worker.env de cada VM al arrancar.
# =====================================================================

APP_ENV=prod
PUBLIC_BASE_URL=https://<DOMINIO>

DATABASE_URL=postgres://mooc:<DB_PASSWORD>@<IP_CLOUDSQL>:5432/mooc?sslmode=require

# Redis vive en infra-server, fuera del grupo: el autoescalador puede
# retirar cualquier worker sin perder la cola.
REDIS_ADDR=<IP_INFRA>:6379
REDIS_PASSWORD=<REDIS_PASSWORD>

# --- Cloud Storage (llave HMAC de mooc-worker, distinta a la de la API) ---
S3_ENDPOINT=storage.googleapis.com
S3_PUBLIC_ENDPOINT=storage.googleapis.com
S3_ACCESS_KEY=<HMAC_ACCESS_ID>
S3_SECRET_KEY=<HMAC_SECRET>
S3_BUCKET=<BUCKET>
S3_REGION=auto
S3_USE_SSL=true
CDN_BASE_URL=

SMTP_ADDR=<IP_INFRA>:1025
SMTP_FROM=no-reply@mooc.local

SIGNED_URL_TTL_MINUTES=15

# --- Workers ---
# Concurrencia POR INSTANCIA, igual que en la Entrega 2 para comparar. Con 2
# vCPU, dos transcodificaciones simultaneas ya saturan la maquina.
WORKER_CONCURRENCY=2
MAX_RETRIES=3

ANTIMALWARE_MODE=stub
CLAMAV_ADDR=

OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_SAMPLE_RATIO=1.0
