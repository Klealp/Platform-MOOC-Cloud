# =====================================================================
# Variables del frontend (BFF). Copia como .env.local
#   cp .env.example .env.local
# =====================================================================

# URL del backend Go. SOLO server-side: no lleva prefijo NEXT_PUBLIC_, por lo
# que el navegador NUNCA la conoce. El browser solo habla con este Next.js.
API_BASE_URL=http://localhost:8080/api/v1

# Entorno. En "production" la cookie de sesion se marca Secure (solo HTTPS).
NODE_ENV=development

# Nombre de la cookie HttpOnly que guarda el token opaco de sesion.
SESSION_COOKIE_NAME=mooc_session
